@model Carniceria.Models.Producto

@{
    ViewData["Title"] = "Buscar Producto";
}

<h2>Buscar Producto en Inventario</h2>
<hr />

<!-- Formulario para ingresar el término de búsqueda -->
<div style="margin-bottom: 30px;">
    <form asp-action="Buscar" method="post">
        <p>
            <label style="font-weight: bold;">Ingrese el Código del Producto:</label><br />
            
            <input type="text" name="codigoProducto" required style="padding: 5px; width: 300px;" placeholder="Ejemplo: CAR-001" />
            <input type="submit" value="Buscar" style="background-color: #007bff; color: white; border: none; padding: 7px 15px; cursor: pointer;" />
        </p>
    </form>
</div>

<!-- Sección para mostrar alertas -->
@if (ViewBag.Mensaje != null)
{
    <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border: 1px solid #f5c6cb; margin-bottom: 20px;">
        <strong>Aviso:</strong> @ViewBag.Mensaje
    </div>
}

<!-- Sección para mostrar los datos si la búsqueda fue exitosa -->
@if (Model != null)
{
    <div style="border: 1px solid #28a745; padding: 20px; background-color: #e9f7ef;">
        <h4 style="color: #28a745; margin-top: 0;">Producto Encontrado</h4>
        <hr />
        <dl>
            <dt>@Html.DisplayNameFor(model => model.CodigoProducto)</dt>
            <dd>@Html.DisplayFor(model => model.CodigoProducto)</dd>

            <dt>@Html.DisplayNameFor(model => model.NombreProducto)</dt>
            <dd>@Html.DisplayFor(model => model.NombreProducto)</dd>

            <dt>@Html.DisplayNameFor(model => model.Categoria)</dt>
            <dd>@Html.DisplayFor(model => model.Categoria)</dd>

            <dt>Precio</dt>
            <dd>@Model.PrecioUnidadMedida.ToString("C")</dd>

            <dt>Existencias Registradas</dt>
            <dd>
                @Html.DisplayFor(model => model.ExistenciaActual) @Html.DisplayFor(model => model.UnidadMedida)
                @if (Model.ExistenciaActual <= Model.ExistenciaMinima)
                {
                    <span style="color: red; font-weight: bold; margin-left: 10px;">[ALERTA: STOCK BAJO]</span>
                }
            </dd>
        </dl>

        <!-- Botones de acción directa sobre el producto encontrado -->
        <div style="margin-top: 15px;">
            <a asp-action="Actualizar" asp-route-id="@Model.Id" style="background-color: #ffc107; color: black; padding: 5px 15px; text-decoration: none; border: 1px solid #ccc;">Editar Datos</a> |
            <a asp-action="Eliminar" asp-route-id="@Model.Id" style="background-color: #dc3545; color: white; padding: 5px 15px; text-decoration: none;">Eliminar Producto</a>
        </div>
    </div>
}

<div style="margin-top: 30px;">
    <a asp-action="Index">Volver al inventario completo</a>
</div>