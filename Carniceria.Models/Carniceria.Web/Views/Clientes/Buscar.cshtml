@model Carniceria.Models.Cliente

@{
    ViewData["Title"] = "Buscar Cliente";
}

<h2>Buscar Cliente por Identificación</h2>

<!-- 1. El Formulario de búsqueda -->
<form asp-action="Buscar" method="post" style="margin-bottom: 20px;">
    <div style="margin-bottom: 15px;">
        <label style="font-weight: bold;">Ingrese la identificación exacta:</label><br />
        <!-- OJO AQUÍ: El atributo name="identificacion" debe llamarse exactamente igual
             al parámetro que pusiste en tu método [HttpPost] Buscar(string identificacion) -->
        <input type="text" name="identificacion" style="padding: 5px; width: 100%; max-width: 300px;" required />
    </div>
    <div>
        <input type="submit" value="Buscar Cliente" style="background-color: #17a2b8; color: white; padding: 8px 15px; border: none; cursor: pointer; font-weight: bold;" />
        <a asp-action="Index" style="margin-left: 15px; text-decoration: none; color: #6c757d; font-weight: bold;">Volver al Listado</a>
    </div>
</form>

<hr />

<!-- 2. Requerimiento cumplido: Mensaje de error si no existe -->
@if (ViewBag.Mensaje != null)
{
    <div style="color: #d9534f; font-weight: bold; margin-bottom: 15px; padding: 15px; border: 1px solid #d9534f; background-color: #fdf5f5; max-width: 450px;">
        @ViewBag.Mensaje
    </div>
}

<!-- 3. Mostrar la tarjeta con la información si la búsqueda fue exitosa -->
@if (Model != null)
{
    <h3 style="color: #28a745; margin-top: 20px;">Resultado de la búsqueda</h3>
    <div style="margin-bottom: 25px; border: 1px solid #ddd; padding: 15px; max-width: 450px; background-color: #f8f9fa;">
        <p><strong>Id Interno:</strong> <span style="color: gray; font-size: 0.9em;">@Model.Id</span></p>
        <p><strong>@Html.DisplayNameFor(model => model.TipoIdentificacion):</strong> @Model.TipoIdentificacion</p>
        <p><strong>@Html.DisplayNameFor(model => model.Identificacion):</strong> @Model.Identificacion</p>
        <p><strong>Nombre Completo:</strong> @Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</p>
        <p><strong>@Html.DisplayNameFor(model => model.FechaNacimiento):</strong> @Model.FechaNacimiento.ToShortDateString()</p>

        <!-- Agregamos atajos útiles para no tener que volver a la tabla -->
        <div style="margin-top: 15px;">
            <a asp-action="Actualizar" asp-route-id="@Model.Id" style="text-decoration: none; color: #007bff; font-weight: bold;">Editar datos</a> |
            <a asp-action="Eliminar" asp-route-id="@Model.Id" style="text-decoration: none; color: #d9534f; font-weight: bold;">Eliminar registro</a>
        </div>
    </div>
}