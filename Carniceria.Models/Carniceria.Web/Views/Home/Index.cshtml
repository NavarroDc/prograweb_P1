@{
    ViewData["Title"] = "Panel Principal";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Gestión Integrado</h1>
    <p>Bienvenido. Seleccione el módulo al que desea ingresar:</p>

    <!-- Usamos clases de Bootstrap (btn, btn-primary) que ya vienen instaladas para que se vean como botones reales -->
    <div style="margin-top: 40px; display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-primary btn-lg" style="width: 200px;">
            Gestión de Clientes
        </a>
        <a asp-controller="Empleados" asp-action="Index" class="btn btn-secondary btn-lg" style="width: 200px;">
            Gestión de Empleados
        </a>
        <a asp-controller="Inventario" asp-action="Index" class="btn btn-secondary btn-lg" style="width: 200px;">
            Inventario de Productos
        </a>
        <a asp-controller="Proveedores" asp-action="Index" class="btn btn-secondary btn-lg" style="width: 200px;">
            Gestión de Proveedores
        </a>
    </div>
</div>