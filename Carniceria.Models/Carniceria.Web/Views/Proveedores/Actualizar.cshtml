@model Carniceria.Models.Proveedor

@{
    ViewData["Title"] = "Actualizar Proveedor";
}

<h2>Actualizar Proveedor</h2>
<hr />

<form asp-action="Actualizar" method="post">

    
    <input type="hidden" asp-for="Id" />

    <p>
        <label asp-for="TipoIdentificacion"></label><br />
        <select asp-for="TipoIdentificacion">
            <option value="">-- Seleccione una opción --</option>
            <option value="Cédula nacional">Cédula nacional</option>
            <option value="Cédula jurídica">Cédula jurídica</option>
            <option value="DIMEX">DIMEX</option>
        </select>
        <span asp-validation-for="TipoIdentificacion" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="Identificacion"></label><br />
        <input asp-for="Identificacion" />
        <span asp-validation-for="Identificacion" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="RazonSocial"></label><br />
        <input asp-for="RazonSocial" />
        <span asp-validation-for="RazonSocial" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="PersonaContacto"></label><br />
        <input asp-for="PersonaContacto" />
        <span asp-validation-for="PersonaContacto" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="Telefono"></label><br />
        <input asp-for="Telefono" />
        <span asp-validation-for="Telefono" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="CorreoElectronico"></label><br />
        <input asp-for="CorreoElectronico" />
        <span asp-validation-for="CorreoElectronico" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="TipoSuministro"></label><br />
        <select asp-for="TipoSuministro">
            <option value="">-- Seleccione una opción --</option>
            <option value="Carne de Res">Carne de Res</option>
            <option value="Carne de Cerdo">Carne de Cerdo</option>
            <option value="Pollo">Pollo</option>
            <option value="Embutidos">Embutidos</option>
            <option value="Productos Procesados">Productos Procesados</option>
            <option value="Empaques">Empaques</option>
            <option value="Condimentos">Condimentos</option>
            <option value="Otros">Otros</option>
        </select>
        <span asp-validation-for="TipoSuministro" style="color: red; margin-left: 10px;"></span>
    </p>

    <p>
        <label asp-for="FrecuenciaEntrega"></label><br />
        <select asp-for="FrecuenciaEntrega">
            <option value="">-- Seleccione una opción --</option>
            <option value="Diaria">Diaria</option>
            <option value="Dos veces por semana">Dos veces por semana</option>
            <option value="Semanal">Semanal</option>
            <option value="Quincenal">Quincenal</option>
            <option value="Contra pedido">Contra pedido</option>
        </select>
        <span asp-validation-for="FrecuenciaEntrega" style="color: red; margin-left: 10px;"></span>
    </p>

    <p style="margin-top: 20px;">
        <input type="submit" value="Guardar Cambios" /> |
        <a asp-action="Index">Cancelar y volver al inventario</a>
    </p>

</form>