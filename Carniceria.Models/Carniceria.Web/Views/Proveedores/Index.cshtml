@model IEnumerable<Carniceria.Models.Proveedor>

@{
    ViewData["Title"] = "Directorio de Proveedores";
}


<h2>Directorio de Proveedores</h2>

<!-- Enlaces simples de acción superior -->
<p>
    <a asp-action="Create">Registrar Nuevo Proveedor</a> |
    <a asp-action="Buscar">Ir a Buscar Proveedor</a>
</p>

<!-- Alerta de éxito -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Contenedor para que la tabla sea responsiva si hay muchas columnas -->
<div class="table-responsive">
    
    <table class="table table-bordered table-striped table-hover mt-3">
        <thead class="table-light">
            <tr>
                <th>Código (ID)</th>
                <th>Tipo de Identificación</th>
                <th>Identificación</th>
                <th>Razón Social</th>
                <th>Contacto</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Suministro</th>
                <th>Frecuencia</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <!-- ID mostrado en formato pequeño -->
                        <td><small class="text-muted">@item.Id</small></td>
                        <td>@Html.DisplayFor(modelItem => item.TipoIdentificacion)</td>
                        <td>@Html.DisplayFor(modelItem => item.Identificacion)</td>
                        <td>@Html.DisplayFor(modelItem => item.RazonSocial)</td>
                        <td>@Html.DisplayFor(modelItem => item.PersonaContacto)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.CorreoElectronico)</td>
                        <td>@Html.DisplayFor(modelItem => item.TipoSuministro)</td>
                        <td>@Html.DisplayFor(modelItem => item.FrecuenciaEntrega)</td>

                        <!-- Enlaces de acción  -->
                        <td class="text-center">
                            <a asp-action="Actualizar" asp-route-id="@item.Id" class="text-dark fw-bold text-decoration-none">Editar</a> |
                            <a asp-action="Eliminar" asp-route-id="@item.Id" class="text-dark fw-bold text-decoration-none">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10">
                        Aún no hay proveedores registrados en el directorio.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>